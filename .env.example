# Generate a random token locally; client and server must use the same value.
GAIA_SERVER_TOKEN=replace-with-a-random-token
VLLM_API_KEY=local-vllm
# Only the dataset download command needs this token, never forward to sandboxes.
HF_TOKEN=
# Required by the upstream GAIA tool profile. Passed only to the task's MCP worker.
TAVILY_API_KEY=
